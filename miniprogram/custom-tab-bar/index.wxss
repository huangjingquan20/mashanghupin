.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.tab-text--active {
  color: #FF6B35;
  font-weight: 600;
}

/* 发布按钮浮出效果 */
.tab-item--plus .tab-icon--plus {
  position: relative;
  top: -16rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.3);
}

.tab-item--plus .tab-text {
  margin-top: -10rpx;
}

/* CSS 绘制的图标 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 首页图标 - 房子 */
.icon-house {
  width: 38rpx;
  height: 32rpx;
  border-left: 3rpx solid #999;
  border-right: 3rpx solid #999;
  border-bottom: 3rpx solid #999;
  position: relative;
  box-sizing: border-box;
}
.icon-house::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: -5rpx;
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 14rpx solid #999;
}
.tab-item--active .icon-house {
  border-color: #FF6B35;
}
.tab-item--active .icon-house::before {
  border-bottom-color: #FF6B35;
}

/* 发布图标 - 十字 */
.icon-plus-sign {
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
  position: relative;
}
.icon-plus-sign::after {
  content: '';
  position: absolute;
  top: -18rpx;
  left: 18rpx;
  width: 4rpx;
  height: 40rpx;
  background: #FF6B35;
  border-radius: 2rpx;
}

/* 我的图标 - 人形 */
.icon-person {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}
.icon-person::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  box-sizing: border-box;
}
.tab-item--active .icon-person {
  border-color: #FF6B35;
}
.tab-item--active .icon-person::before {
  border-color: #FF6B35;
}
