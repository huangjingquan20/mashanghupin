.publish-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 30rpx;
}

.publish-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
}

.publish-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.publish-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.publish-subtitle {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ===== 上传 ===== */
.upload-section {
  margin-bottom: 30rpx;
}

.upload-area {
  width: 100%;
  height: 360rpx;
  background: #fafafa;
  border: 3rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-camera-icon {
  margin-bottom: 16rpx;
}

.camera-body {
  width: 72rpx;
  height: 56rpx;
  border: 4rpx solid #ccc;
  border-radius: 10rpx;
  position: relative;
}

.camera-body::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  border: 4rpx solid #ccc;
  border-radius: 4rpx 4rpx 0 0;
  border-bottom: none;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-tip {
  font-size: 22rpx;
  color: #ccc;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #eee;
  border-top-color: var(--primary);
  border-radius: 50%;
  margin-bottom: 16rpx;
  animation: spin .8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg) } }

/* ===== 图片预览 ===== */
.image-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.image-preview-small {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #f0f0f0;
}

.image-rechoose {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0,0,0,.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rechoose-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}

.rechoose-icon::before,
.rechoose-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: #fff;
}

.rechoose-icon::before { transform: rotate(45deg) }
.rechoose-icon::after  { transform: rotate(-45deg) }

/* ===== 分析中 ===== */
.analyze-status {
  text-align: center;
  padding: 20rpx 0;
}

.analyze-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
}

.dot-pulse {
  width: 16rpx;
  height: 16rpx;
  background: var(--primary);
  border-radius: 50%;
  margin-right: 12rpx;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: .3; transform: scale(.8) }
  50% { opacity: 1; transform: scale(1.2) }
}

/* ===== OCR 识别结果（只读） ===== */
.ocr-result {
  background: #FFF9F5;
  border: 1rpx solid #FFE8D6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.ocr-label {
  font-size: 22rpx;
  color: var(--primary);
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}

.ocr-label::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  background: var(--primary);
  border-radius: 50%;
  margin-right: 8rpx;
}

.ocr-item {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.ocr-item:last-child {
  margin-bottom: 0;
}

.ocr-item-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ocr-item-value {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.ocr-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.ocr-warning {
  background: #FFF8F5;
  border: 1rpx solid #FFE0D0;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--primary);
  line-height: 1.7;
  text-align: center;
}

.ocr-fallback {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

/* ===== 表单输入 ===== */
.form-input {
  width: 100%;
  height: 76rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.price-row {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding-left: 20rpx;
}

.price-prefix {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
  margin-right: 6rpx;
}

.price-field {
  background: transparent;
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

/* ===== OCR 诊断 ===== */
.diag-box {
  background: #FFF8F5;
  border: 1rpx solid #FFE0D0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.diag-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 10rpx;
}

.diag-msg {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.diag-detail {
  margin-top: 8rpx;
}

.diag-row {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.diag-texts {
  color: #999;
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 8rpx 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
}

.detail-box {
  max-height: 400rpx;
  overflow-y: auto;
  margin-top: 10rpx;
}

.detail-title {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.detail-line {
  font-size: 20rpx;
  color: #999;
  line-height: 1.6;
  word-break: break-all;
  padding: 2rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ===== 分类选择 ===== */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.required {
  color: var(--primary);
}

.decimal-hint {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: normal;
}

.category-scroll {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-chip {
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 27rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  display: flex;
  align-items: center;
}

.cat-chip--active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary), #FF8C5A);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 10rpx;
}

.submit-btn::after { border: none }
.submit-btn--disabled { opacity: .6 }

/* ===== 教程角标 ===== */
.tutorial-corner {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  background: rgba(0,0,0,.45);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
}

.tutorial-q {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  line-height: 28rpx;
  margin-right: 8rpx;
}

.tutorial-label { color: #fff; font-size: 22rpx }

/* ===== 教程弹窗 ===== */
.tutorial-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity .3s, visibility .3s;
}

.tutorial-overlay--show { opacity: 1; visibility: visible }

.tutorial-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.tutorial-modal__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title { font-size: 32rpx; font-weight: 600; color: #333 }

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x { position: relative; width: 30rpx; height: 30rpx }
.close-x::before, .close-x::after {
  content: '';
  position: absolute;
  top: 50%; left: 0;
  width: 100%; height: 2rpx;
  background: #999;
}
.close-x::before { transform: rotate(45deg) }
.close-x::after  { transform: rotate(-45deg) }

.tutorial-modal__body { padding-bottom: 20rpx }

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.step-badge {
  width: 42rpx;
  height: 42rpx;
  background: linear-gradient(135deg, var(--primary), #FF8C5A);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.step-content {
  flex: 1;
}

.step text { font-size: 28rpx; color: #333; line-height: 1.6 }

.step-img {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tutorial-img {
  width: 100%;
}

.step .step-content text {
  display: block;
  margin-bottom: 8rpx;
}

.bottom-placeholder { height: 120rpx }

/* ===== 锁定输入框 ===== */
.form-input--locked {
  background: #f0f0f0;
  color: #999;
}

/* ===== 匹配状态 ===== */
.match-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  margin-bottom: 20rpx;
  display: inline-block;
}

.match-status--success {
  background: #E8F8E8;
  color: #52C41A;
}

.match-status--fail {
  background: #FFF2F0;
  color: #FF4D4F;
}

/* ===== 选填提示 ===== */
.optional-hint {
  font-size: 22rpx;
  color: #bbb;
  font-weight: normal;
}
