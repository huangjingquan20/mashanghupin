.feedback-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx 30rpx;
}

.feedback-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.feedback-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.feedback-subtitle {
  font-size: 26rpx;
  color: #bbb;
}

.feedback-input {
  width: 100%;
  min-height: 300rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.feedback-count {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after { border: none }

.submit-btn--disabled { opacity: .6 }

.feedback-done {
  text-align: center;
  padding: 80rpx 0;
}

.done-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.done-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.done-tip {
  font-size: 26rpx;
  color: #bbb;
}
