.mine-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 用户区域 */
.user-section {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, var(--primary), #FF8C5A);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  margin-right: 24rpx;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.feedback-entry {
  position: absolute;
  bottom: 12rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 4rpx 12rpx;
}


/* Tab 切换 */
.tab-section {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.tab-item--active {
  color: var(--primary);
  font-weight: 600;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

/* 列表 */
.group-list {
  padding: 20rpx 30rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

.bottom-placeholder {
  height: 120rpx;
}
